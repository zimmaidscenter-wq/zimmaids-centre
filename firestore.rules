rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Global Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "zimmaidscentre@gmail.com" ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && incoming().uid == userId;
      allow update: if (isOwner(userId) || isAdmin()) && incoming().uid == userId;
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /verifications/{verificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Workers Collection
    match /workers/{workerId} {
      allow read: if true;
      allow create, update: if isOwner(workerId) || isAdmin();
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      match /training/{enrollmentId} {
        allow read: if isOwner(workerId) || isAdmin();
        allow create, update: if isOwner(workerId) || isAdmin();
      }
    }

    // 3. Employers Collection
    match /employers/{employerId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(employerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Jobs Collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (existing().employerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().employerId == request.auth.uid || isAdmin());

      match /applications/{applicationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().workerId == request.auth.uid;
        allow update: if isSignedIn() && (
          incoming().workerId == request.auth.uid || 
          get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid ||
          isAdmin()
        );
      }

      match /milestones/{milestoneId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 5. Applications Top-Level Mirror Collection
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.workerId == request.auth.uid || 
        resource.data.employerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().workerId == request.auth.uid;
      allow update: if isSignedIn() && (
        existing().workerId == request.auth.uid || 
        existing().employerId == request.auth.uid || 
        isAdmin()
      );
    }

    // 6. Messages & Chats Collection
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow create: if isSignedIn() && (
        request.auth.uid in incoming().participants
      );
      allow update: if isSignedIn() && (
        request.auth.uid in existing().participants || isAdmin()
      );

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin()
        );
      }
    }

    // 7. Payments Collection
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.employerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin();

      match /escrowLogs/{logId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // 8. Reviews Top-Level Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().employerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 9. Notifications Top-Level Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientUserId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 10. Reports Collection
    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterUserId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().reporterUserId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 11. Verifications Collection
    match /verifications/{verificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 12. Subscriptions Collection
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 13. Training Modules
    match /trainingModules/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // 14. Blog Posts
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // 15. System Settings
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 16. Admin Audit Logs & Admin Users
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /adminUsers/{adminId} {
      allow read, write: if isAdmin();
    }

    // 17. Roles (RBAC)
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 18. Permissions (RBAC)
    match /permissions/{permissionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
